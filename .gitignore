# Python build and cache artefacts.
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.eggs/

# Test and tooling caches.
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
coverage.xml
htmlcov/

# Environments.
.venv/
venv/
env-for-saggio/

# Editor and operating-system noise.
.DS_Store
.idea/
.vscode/

# Secrets. Committed *.example files stay tracked.
*.env
!*.env.example
secrets.yaml
secrets.yml
settings.yaml

# Cost models a run produces here, as opposed to the ones a project commits.
/scratch/

# Local-only scratch space, never committed.
/.private/

# The film's intermediates. The frames are a gigabyte of PNGs that exist
# only between the composition and ffmpeg, and the rendered films are
# published to the site rather than carried here. Both are rebuilt by
# `python film/render_film.py`; the narration beside them is committed,
# because the cuts are derived from its measured length.
film/frames/
film/out/
# What was handed to the voice, which script.yaml already says.
film/narration/*/*/segments.json
